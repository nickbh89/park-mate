    "name": "Private Parking Single Code of Practice (Parking (Code of Practice) Act 2019)",
    "considerationPeriodMinutes": 5,
    "gracePeriodMinutes": 10,
    "chargeCapsGBP": {
      "standardOutsideLondon": 50,
      "seriousOutsideLondon": 80,
      "standardLondon": 80,
      "seriousLondon": 130
    },
    "notes": "5-min consideration period on arrival before any charge; 10-min grace period after paid/free time expires. Phased implementation from 2024-2026."
  }
