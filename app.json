{
  "expo": {
    "name": "ParkMate",
    "slug": "parkmate",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e1726",
    "android": {
      "package": "com.nickbh89.parkmate",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1726"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ParkMate uses your location, including in the background, to detect privately enforced car parks and warn you before parking charges.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad12aea8-4231-4a8e-8db1-08bd67a5f3de"
      }
    },
    "owner": "nickbh"
  }
}
